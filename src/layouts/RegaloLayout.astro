---
import "../styles/base.css";
import "../styles/sobre.css";
import nocturnoCss from "../temas/tokens-nocturno.css?raw";
import papelCss from "../temas/tokens-papel.css?raw";
import luminosoCss from "../temas/tokens-luminoso.css?raw";
import { registro } from "../bloques/registro.ts";
import type { Contenido } from "../lib/contenido/tipos-bloque.ts";

interface Props {
  tema: string;
  contenido: Contenido;
  // null en /revisar/[id]: la pantalla de apertura se ve y se comporta igual, pero no
  // dispara POST /api/abrir — esa marca es del destinatario real, no de la vista previa
  // del comprador (Principio VI: primera_apertura_en es irreversible, research.md #19).
  slug: string | null;
}

const { tema, contenido, slug } = Astro.props;

// Los tres temas se cargan siempre; el atributo data-tema en <html> decide cuál
// aplica (cada archivo se scopea con [data-tema="..."]). luminoso es el default.
const cssTemas = luminosoCss + nocturnoCss + papelCss;
const temaAplicado = tema === "nocturno" || tema === "papel" ? tema : "luminoso";

// El layout solo *lee* nombreDestinatario del primer bloque portada, si existe
// (research.md #22) — una receta sin portada muestra un texto genérico.
const primerPortada = contenido.receta.find(
  (b): b is typeof b & { nombreDestinatario?: string } => b.tipo === "portada",
);
const nombreDestinatario =
  typeof primerPortada?.nombreDestinatario === "string" ? primerPortada.nombreDestinatario : null;
const saludo = nombreDestinatario ? `Tenés un regalo, ${nombreDestinatario}` : "Tenés un regalo";

const recetaOrdenada = [...contenido.receta].sort((a, b) => a.posicion - b.posicion);
---

<html lang="es" data-tema={temaAplicado}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Un regalo para vos</title>
    <style set:html={cssTemas} />
  </head>
  <body>
    <div id="sobre">
      <p class="titulo">{saludo}</p>
      <p class="fecha">Un regalo para vos</p>
      <div class="escena">
        <div class="pieza">
          <div class="tarjeta"><span>♥</span></div>
          <div class="sobre-cuerpo"></div>
          <div class="solapa"></div>
          <button type="button" id="abrir-sobre" class="sello" data-pantalla-apertura data-slug={slug ?? ""}>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 21c-.3 0-.6-.1-.8-.3C6.4 16.8 2 12.9 2 8.6 2 5.5 4.4 3 7.5 3c1.8 0 3.4.9 4.5 2.3C13.1 3.9 14.7 3 16.5 3 19.6 3 22 5.5 22 8.6c0 4.3-4.4 8.2-9.2 12.1-.2.2-.5.3-.8.3Z"></path>
            </svg>
            <p class="sr-only">{saludo}</p>
          </button>
        </div>
      </div>
      <p class="pista">Tocá para abrir</p>
    </div>
    <canvas id="corazones"></canvas>

    <main id="contenido" data-contenido hidden>
      {
        recetaOrdenada.map((bloque) => {
          const Componente = registro[bloque.tipo];
          return Componente ? <Componente {...bloque} /> : null;
        })
      }
    </main>
    <slot />
    <script>
      import { activarSobre } from "../lib/corazones.js";

      const contenido = document.getElementById("contenido");
      const boton = document.getElementById("abrir-sobre");
      const slug = boton?.dataset.slug ?? "";

      activarSobre(() => {
        if (!contenido) return;
        contenido.hidden = false;

        if (slug) {
          // Fire-and-forget: revelar el contenido nunca espera esta respuesta
          // (research.md #19, contracts/api-abrir.md).
          fetch(`/api/abrir/${slug}`, { method: "POST", keepalive: true }).catch(() => {});
        }
      });
    </script>
  </body>
</html>
