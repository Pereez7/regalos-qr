---
interface Props {
  texto?: string;
}

const { texto } = Astro.props;
---

{
  texto && (
    <section data-bloque="cierre">
      <p>{texto}</p>
    </section>
  )
}

<style>
  section {
    text-align: center;
    padding: var(--e-6) var(--e-2);
  }
  p {
    font-family: var(--f-mano);
    font-size: var(--t-titulo);
    color: var(--realce);
    margin: 0;
  }
</style>
