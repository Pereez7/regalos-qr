---
interface Props {
  texto: string;
}

const { texto } = Astro.props;
// Una carta vacía se omite en el render, igual que un tipo desconocido
// (data-model.md, Reglas de evolución).
const tieneContenido = typeof texto === "string" && texto.trim().length > 0;
---

{
  tieneContenido && (
    <section data-bloque="carta">
      <p>{texto}</p>
    </section>
  )
}

<style>
  section {
    padding: var(--e-4) var(--e-3);
    background: var(--papel);
    border-radius: var(--radio);
    box-shadow: var(--sombra-card);
  }
  p {
    max-width: var(--ancho-texto);
    margin-inline: auto;
    font-family: var(--f-mano);
    font-size: var(--t-carta);
    line-height: var(--i-cuerpo);
    color: var(--tinta);
  }
</style>
