---
import VentaLayout from "../layouts/VentaLayout.astro";
// La banda oscura de "Qué ve quien lo recibe" usa el tema `nocturno` DEL PRODUCTO, no un
// gris inventado: el visitante ve, en la propia página de venta, uno de los tres climas que
// puede elegir. El archivo solo define `[data-tema="nocturno"]`, así que no toca nada fuera
// de la sección que lleva ese atributo.
import "../temas/tokens-nocturno.css";
import { formatearPrecio, precioVigente, type Precio } from "../lib/config.ts";
import { obtenerSlugDeEjemplo } from "../lib/ejemplos.ts";

export const prerender = false;

// FR-001: qué es el regalo, al menos un ejemplo real navegable, el precio, y una sola
// acción de compra. Sin JavaScript: el formulario es un <form> plano que postea a /comprar.
//
// El enlace de arriba no es una segunda oferta: es un ancla al mismo formulario. La página
// es larga porque responde objeciones, y obligar a scrollear hasta el final para comprar
// sería cobrarle al que ya está convencido.
//
// El precio se lee en runtime (research.md #18). Si falta, la página lo dice y NO ofrece
// comprar: vender sin saber cuánto se cobra es peor que no vender.

let precio: Precio | null = null;
let errorPrecio: string | null = null;
try {
  precio = precioVigente();
} catch (e) {
  errorPrecio = e instanceof Error ? e.message : "Precio no configurado";
}

const slugEjemplo = await obtenerSlugDeEjemplo();
---

<VentaLayout titulo="Un regalo que se abre con un QR">
  <header class="portada">
    {/* El sobre no es una ilustración: es el mismo gesto que va a hacer quien reciba el
        regalo, en chico y en bucle. Es lo más característico del producto y lo primero que
        se ve. CSS puro, sin una imagen que descargar ni un byte de JavaScript. */}
    <div class="vitrina" aria-hidden="true">
      <div class="sobre-mini">
        <span class="carta">
          <em class="para">Ana</em>
          <em class="dias"><b data-contador>1001</b> días juntos</em>
        </span>
        <span class="cuerpo"></span>
        <span class="solapa"></span>
        <span class="sello">♥</span>
      </div>
    </div>

    <p class="rotulo">Un regalo que se abre con un QR</p>

    <h1>Una tarjeta con un QR. Detrás, todo lo que no cabe en una tarjeta.</h1>

    <p class="entradilla">
      Quien lo recibe escanea el código y se abre un sobre. Adentro está su nombre, los
      momentos que elegiste guardar, las fotos, la canción que elegiste, la carta que le
      escribiste y las preguntas que le dejaste.
    </p>

    <p class="apoyo">
      Se lee en el celular, sin instalar nada y sin crear ninguna cuenta.
    </p>

    <p class="destacado">
      Una tarjeta se lee una vez y termina en un cajón. Esto se vuelve a abrir el mes que
      viene, el aniversario que viene y dentro de diez años:{" "}
      <strong>el enlace no vence nunca y no cambia nunca.</strong>
    </p>

    <p class="acciones">
      {
        precio && (
          <a class="boton" href="#comprar">
            Quiero el mío por {formatearPrecio(precio)}
          </a>
        )
      }
      {
        slugEjemplo ? (
          <a class="boton boton-secundario" href={`/r/${slugEjemplo}`} data-ejemplo>
            Abrir un regalo de ejemplo
          </a>
        ) : (
          <span data-sin-ejemplo>Todavía no hay un ejemplo publicado para mostrar acá.</span>
        )
      }
    </p>

    {
      slugEjemplo && (
        <p class="apoyo">
          Es un regalo publicado de verdad, servido por el mismo motor que va a servir el
          tuyo. Abrilo desde el celular si podés: está hecho para una mano, no para un
          escritorio.
        </p>
      )
    }
  </header>

  {/* ── Banda oscura: el tema `nocturno` del producto, a sangre ──────────────────────── */}
  <section class="banda entra" data-tema="nocturno">
    <p class="rotulo">Del otro lado</p>
    <h2>Qué ve quien lo recibe</h2>
    <p class="entradilla">
      Un sobre cerrado. Nada más, hasta que lo toca. Y entonces, de a un bloque, aparece
      todo esto:
    </p>

    <ol class="secuencia entra">
      <li>
        <strong>Su nombre</strong>
        <span>La cuenta de los días desde la fecha que vos elegiste.</span>
      </li>
      <li>
        <strong>Los momentos</strong>
        <span>De a uno, como quien da vuelta una página.</span>
      </li>
      <li>
        <strong>Las fotos</strong>
        <span>Las que pusiste, hasta diez.</span>
      </li>
      <li>
        <strong>La canción</strong>
        <span>La que elegiste, para escuchar sin salir del regalo.</span>
      </li>
      <li>
        <strong>Tu carta</strong>
        <span>Entera y sin recortar.</span>
      </li>
      <li>
        <strong>Las preguntas</strong>
        <span>Las que le dejaste, de a una, con su respuesta.</span>
      </li>
      <li>
        <strong>El cierre</strong>
        <span>Las últimas palabras.</span>
      </li>
    </ol>

    <p class="apoyo">
      No le pedimos cuenta, contraseña ni una app. Y el regalo no está en buscadores ni en
      ningún listado: lo abre quien tenga el enlace, y el enlace lo das vos.
    </p>
  </section>

  <section class="filete entra">
    <p class="rotulo">Cómo se hace</p>
    <h2>Vos contás. No diseñás nada.</h2>
    <p class="entradilla">
      Son siete pasos, y cada paso es una pregunta.
    </p>
    <p class="apoyo">
      Contestás con tus palabras —nadie las reescribe ni las corrige— y el resto lo ponemos
      nosotros: el ritmo, la tipografía, el sobre que se abre.
    </p>

    <ol class="pasos entra">
      <li>
        <strong>Para quién es.</strong>
        <span>
          El nombre de quien lo recibe, cuál de los tres climas visuales querés —nocturno,
          papel o luminoso— y desde qué fecha se cuentan los días.
        </span>
      </li>
      <li>
        <strong>Los momentos.</strong>
        <span>Lo que pasó y vale la pena volver a contar.</span>
      </li>
      <li>
        <strong>Las fotos.</strong>
        <span>Hasta diez.</span>
      </li>
      <li>
        <strong>La canción.</strong>
        <span>Un enlace de Spotify o de YouTube, que se escucha adentro del regalo.</span>
      </li>
      <li>
        <strong>La carta.</strong>
        <span>Lo que le dirías si tuvieras una hoja en blanco y todo el tiempo del mundo.</span>
      </li>
      <li>
        <strong>Las preguntas.</strong>
        <span>Con su respuesta, para que aparezcan de a una.</span>
      </li>
      <li>
        <strong>El cierre.</strong>
        <span>Cómo lo terminás.</span>
      </li>
    </ol>

    <p class="nota">
      <strong>Se guarda a cada paso.</strong> Podés empezar en el colectivo, cerrar el
      celular en el segundo paso y seguir tres días después desde otra computadora: tu
      pedido es un enlace propio, no una cuenta que tengas que recordar. Guardalo apenas lo
      tengas —marcalo, mandátelo por mensaje a vos mismo— porque es la única llave.
    </p>
  </section>

  <section class="marco entra">
    <p class="rotulo">Antes de que exista</p>
    <h2>Nada se publica hasta que vos lo apruebes</h2>
    <p>
      Cuando terminás, te damos un enlace de revisión donde ves tu regalo exactamente como
      lo va a ver quien lo recibe, sobre incluido. Si algo no te gusta, volvés y lo cambiás.
      Y otra vez. Y otra. Corregir no tiene límite ni cuesta nada: recién cuando vos
      aprobás, queda.
    </p>
    <p class="apoyo">
      Después de eso ya no se toca, y eso también es a propósito: un regalo entregado no se
      edita a espaldas de quien lo recibió.
    </p>
  </section>

  <section class="filete entra">
    <p class="rotulo">Lo que queda en tus manos</p>
    <h2>Qué recibís vos</h2>

    <div class="tarjetas entra">
      <article class="tarjeta">
        <h3>La página</h3>
        <p>De tu regalo, con su propio enlace, que no vence ni cambia nunca.</p>
      </article>
      <article class="tarjeta">
        <h3>La tarjeta con el QR</h3>
        <p>
          En un archivo listo para imprimir: 10 por 15 centímetros a 300 puntos, el tamaño
          de una foto revelada.
        </p>
      </article>
      <article class="tarjeta">
        <h3>El código suelto</h3>
        <p>
          Aparte de la tarjeta, por si lo querés pegar en una caja, un ramo o un sobre de
          verdad.
        </p>
      </article>
    </div>

    <p class="apoyo">
      No te lo mandamos impreso a tu casa: el archivo es tuyo y lo llevás a imprimir donde
      quieras. Por eso no hay envío que esperar, ni dirección que dejarnos, y elegís vos el
      papel.
    </p>
  </section>

  <section class="filete entra">
    <p class="rotulo">Ocasiones</p>
    <h2>Para cuándo sirve</h2>

    <ul class="ocasiones entra">
      <li>Un aniversario.</li>
      <li>Un cumpleaños.</li>
      <li>Una propuesta de matrimonio, con la pregunta escrita y guardada para siempre.</li>
      <li class="ocasion-madre">
        <span class="rotulo">El caso para el que esto existe</span>
        Estar lejos y querer mandar algo que no sea plata.
      </li>
    </ul>
  </section>

  <section class="panel entra">
    <p class="rotulo">Una sola vez</p>
    <h2>Cuánto cuesta</h2>
    {
      precio ? (
        <p class="precio" data-precio>
          <strong>{formatearPrecio(precio)}</strong>
          <span>
            No hay suscripción, ni mensualidad, ni un plan que se vence y te apaga la
            página: pagás una vez y queda publicada.
          </span>
        </p>
      ) : (
        <p class="aviso" data-precio-faltante>
          El precio no está configurado, así que la compra está cerrada. ({errorPrecio})
        </p>
      )
    }
  </section>

  <section class="filete entra">
    <p class="rotulo">Dudas</p>
    <h2>Preguntas</h2>
    <dl class="entra">
      <dt>¿Tiene que instalar algo o abrirse una cuenta?</dt>
      <dd>
        No. Escanea, se abre en el navegador del celular y listo. Vos tampoco tenés cuenta
        acá: tu pedido es un enlace propio, sin contraseña que recordar ni registro que
        completar.
      </dd>

      <dt>¿El enlace vence?</dt>
      <dd>
        No vence y no cambia. El QR que imprimas hoy va a seguir abriendo el mismo regalo
        dentro de años.
      </dd>

      <dt>¿Lo puede ver cualquiera?</dt>
      <dd>
        No sale en buscadores ni en ningún listado, y la dirección no se adivina. Las fotos
        tampoco quedan en una carpeta pública: viven en un depósito privado y se sirven con
        direcciones firmadas que se mueren al terminar la visita.
      </dd>

      <dt>¿Y si escribo algo y después me arrepiento?</dt>
      <dd>
        Mientras no lo apruebes, lo cambiás todas las veces que quieras, sin costo. Para eso
        está el enlace de revisión.
      </dd>

      <dt>¿Lo escribe una inteligencia artificial?</dt>
      <dd>
        No. Nadie le pone palabras a tu historia. Si vos no lo contás, no existe: eso es,
        exactamente, lo que hace que el regalo sea tuyo.
      </dd>

      <dt>¿Cuánto me va a llevar?</dt>
      <dd>
        Lo que quieras. No hay reloj ni fecha de entrega que corra: se guarda a cada paso y
        volvés cuando puedas.
      </dd>

      <dt>¿Cómo se paga?</dt>
      <dd>
        Escaneando un QR interbancario desde la app de tu banco. No te pedimos ni guardamos
        datos de tarjeta en ningún momento, porque nunca los tocamos.
      </dd>
    </dl>
  </section>

  {
    precio && (
      <section class="panel panel-compra entra">
        <p class="rotulo">Último paso</p>
        <h2 id="comprar">Empezá</h2>
        <p class="entradilla">Dejanos tu correo y te llevamos al QR para pagar.</p>
        <p class="apoyo">
          Apenas pagues te damos el enlace de tu pedido: <strong>guardalo</strong>, es tu
          única llave. Confirmamos la transferencia a mano, así que puede tardar unas horas;
          cuando esté, se abre el primer paso y ya estás contando.
        </p>

        <form method="POST" action="/comprar" data-form-comprar>
          <p>
            <label for="email">Tu correo (para encontrarte si algo sale mal con el pago)</label>
            <input type="email" id="email" name="email" required autocomplete="email" />
          </p>

          <fieldset>
            <legend>Opcional</legend>
            <p>
              <label for="celular">Tu celular</label>
              <input type="tel" id="celular" name="celular" autocomplete="tel" />
            </p>
            {/* FR-035: propósito declarado junto a la casilla, y la casilla NO viene
                pre-marcada. El celular no hace falta para comprar. */}
            <p class="opcional">
              <input
                type="checkbox"
                id="consentimiento_publicidad"
                name="consentimiento_publicidad"
                value="si"
              />
              <label for="consentimiento_publicidad">
                Quiero recibir novedades y promociones por mensaje a ese número. Lo usamos
                solo para eso, y podés darte de baja cuando quieras: la baja borra el número.
              </label>
            </p>
          </fieldset>

          <p class="enviar">
            <button type="submit" class="boton">Comprar por {formatearPrecio(precio)}</button>
          </p>
        </form>

        <p class="apoyo">
          No guardamos datos de tu tarjeta: el pago ocurre dentro de la app de tu banco.
        </p>
      </section>
    )
  }
</VentaLayout>

<script>
  // Motion One, ~5 KB: `animation-timeline: view()` ya hace esto sin JavaScript, pero
  // todavía no está en todos los navegadores —Safari entre ellos—, y la mitad del mercado
  // de este producto es un iPhone. Esta es la única razón por la que hay una librería acá:
  // que el movimiento se vea en TODOS los teléfonos, no solo en Chrome.
  //
  // Nada se oculta desde el HTML: si este script no corre, la página se ve entera. El
  // opacity 0 lo pone el propio script, una fracción antes de animar.
  import { animate } from "motion/mini";
  import { inView, stagger } from "motion";

  const SUAVE = [0.2, 0.8, 0.3, 1] as [number, number, number, number];

  const sinMovimiento = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  if (!sinMovimiento) {
    const entradas = document.querySelectorAll<HTMLElement>(".entra");

    for (const elemento of entradas) {
      elemento.style.opacity = "0";
      elemento.style.transform = "translateY(20px)";
    }

    inView(
      entradas,
      (elemento) => {
        animate(
          elemento,
          { opacity: 1, transform: "translateY(0px)" },
          { duration: 0.7, ease: SUAVE },
        );

        // Las listas y las tarjetas entran de a un ítem: es lo que hace que se lea como algo
        // que se está escribiendo y no como un bloque que aparece de golpe.
        const hijos = elemento.querySelectorAll<HTMLElement>(
          ":scope > li, :scope > dt, :scope > dd, :scope > article",
        );
        if (hijos.length > 0) {
          animate(
            hijos,
            { opacity: [0, 1], transform: ["translateY(10px)", "translateY(0px)"] },
            { duration: 0.5, delay: stagger(0.06), ease: SUAVE },
          );
        }
      },
      { amount: 0.15 },
    );

    // El contador del sobre cuenta hasta su número cuando la página abre: es el gesto que
    // mejor explica el producto —tiempo que se acumula— sin una línea de texto más.
    //
    // A mano y no con la librería: `motion/mini` anima elementos, no números sueltos, y
    // traer el `animate` completo solo para esto costaría más que estas ocho líneas.
    const contador = document.querySelector<HTMLElement>("[data-contador]");
    if (contador) {
      const final = Number(contador.textContent) || 0;
      const empezo = performance.now();
      const dura = 2200;

      const paso = (ahora: number) => {
        const t = Math.min(1, (ahora - empezo) / dura);
        // Misma curva de salida que el resto: rápido al principio, se apoya al final.
        const valor = Math.round(final * (1 - Math.pow(1 - t, 3)));
        contador.textContent = valor.toLocaleString("es-BO");
        if (t < 1) requestAnimationFrame(paso);
      };

      requestAnimationFrame(paso);
    }
  }
</script>

<style>
  /* ════════════════════════════════════════════════════════════════════════════════════
     La landing no es un documento: es una vidriera. Cada sección tiene forma propia —banda
     oscura, marco, panel, tarjetas, filete— y el texto tiene tres pesos (entradilla,
     cuerpo, apoyo) en vez de uno.

     Ni un color, tamaño, espacio ni radio suelto: todo sale de los tokens de base.css y de
     los temas. Donde falta un valor intermedio se deriva con color-mix() de un token.
     ════════════════════════════════════════════════════════════════════════════════════ */

  /* ── Portada ───────────────────────────────────────────────────────────────────────── */

  .portada {
    margin: 0 0 var(--e-5);
  }

  h1 {
    max-width: 24ch;
  }

  /* ── El sobre de la cabecera ─────────────────────────────────────────────────────────
     Mismo gesto que el del regalo, en chico y en bucle lento: la solapa se abre, la carta
     sale, se vuelve a guardar.

     Dentro de `preserve-3d` el orden de dibujo NO lo decide `z-index`: lo decide la
     profundidad en Z. Por eso cada pieza tiene la suya, fija y explícita, en vez de pelear
     con capas. Sin `perspective` en el contenedor, mover algo en Z no cambia su tamaño:
     solo decide quién tapa a quién.

         carta    0px   — el papel, dentro del sobre
         cuerpo  10px   — la cara frontal, siempre delante de la carta
         solapa  20px cerrada / -10px abierta — al abrirse cae por detrás de todo
         sello   30px   — delante de todo, hasta que se desvanece              */

  .vitrina {
    display: flex;
    justify-content: center;
    /* El espacio de arriba es por dónde asoma la carta: sin él, saldría recortada. */
    padding: var(--e-5) 0 var(--e-3);
    /* Un halo tibio detrás del sobre, para que no flote sobre la nada. Derivado de un
       token: el único color nuevo de la página es un --realce muy diluido. */
    background: radial-gradient(
      ellipse at 50% 45%,
      color-mix(in srgb, var(--realce) 16%, transparent),
      transparent 68%
    );
  }

  .sobre-mini {
    position: relative;
    width: min(260px, 70vw);
    aspect-ratio: 1.5 / 1;
    transform-style: preserve-3d;
  }

  .sobre-mini span {
    position: absolute;
    inset: 0;
    border-radius: var(--radio);
  }

  .sobre-mini .cuerpo {
    background: linear-gradient(170deg, var(--sobre-a), var(--sobre-b));
    box-shadow: var(--sombra-card);
    transform: translateZ(10px);
  }

  /* Los pliegues en V del sobre, dibujados con dos degradados en vez de una imagen. */
  .sobre-mini .cuerpo::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.5;
    background:
      linear-gradient(to bottom right, transparent 49.6%, var(--sobre-c) 49.8%, transparent 50.2%),
      linear-gradient(to bottom left, transparent 49.6%, var(--sobre-c) 49.8%, transparent 50.2%);
  }

  .sobre-mini .carta {
    inset: 8% 10% auto 10%;
    height: 78%;
    display: grid;
    align-content: start;
    padding-top: 4%;
    text-align: center;
    line-height: 1.25;
    background: var(--papel);
    box-shadow: var(--sombra-card);
    animation: carta-sube 7s var(--curva) infinite;
  }

  /* Lo que asoma de la carta es una muestra del regalo —un nombre y los días contados—,
     no un adorno: es la promesa del producto en dos líneas. */
  .sobre-mini .carta em {
    display: block;
    font-style: normal;
  }

  .sobre-mini .para {
    font-family: var(--f-mano);
    font-size: 1.6rem;
    color: var(--tinta);
  }

  .sobre-mini .dias {
    font-size: var(--t-etiqueta);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--realce);
  }

  .sobre-mini .dias b {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .sobre-mini .solapa {
    bottom: auto;
    height: 58%;
    transform-origin: top center;
    background: linear-gradient(185deg, var(--sobre-b), var(--sobre-c));
    clip-path: polygon(0 0, 100% 0, 50% 100%);
    animation: solapa-abre 7s var(--curva) infinite;
  }

  .sobre-mini .sello {
    inset: auto auto 38% 50%;
    width: 2.4rem;
    height: 2.4rem;
    display: grid;
    place-items: center;
    color: var(--papel);
    background: var(--acento);
    border-radius: 50%;
    box-shadow: var(--sombra-card);
    animation: sello-late 7s ease-in-out infinite;
  }

  @keyframes solapa-abre {
    0%, 18% { transform: translateZ(20px) rotateX(0deg); }
    42%, 78% { transform: translateZ(-10px) rotateX(178deg); }
    96%, 100% { transform: translateZ(20px) rotateX(0deg); }
  }

  @keyframes carta-sube {
    0%, 26% { transform: translateY(0) scale(0.97); }
    52%, 74% { transform: translateY(-62%) scale(1); }
    94%, 100% { transform: translateY(0) scale(0.97); }
  }

  @keyframes sello-late {
    0%, 14% { opacity: 1; transform: translateZ(30px) translate(-50%, 50%) scale(1); }
    24%, 86% { opacity: 0; transform: translateZ(30px) translate(-50%, 50%) scale(0.3); }
    98%, 100% { opacity: 1; transform: translateZ(30px) translate(-50%, 50%) scale(1); }
  }

  /* ── Ritmo tipográfico ───────────────────────────────────────────────────────────────
     Tres pesos y un rótulo. Antes todos los párrafos pesaban igual y la página se leía
     como un contrato. */

  .rotulo {
    display: flex;
    align-items: center;
    gap: var(--e-1);
    margin: 0 0 var(--e-1);
    font-size: var(--t-etiqueta);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--texto-suave);
  }

  /* El filete corto que abre cada rótulo: la única "decoración" de la página. */
  .rotulo::before {
    content: "";
    flex: 0 0 auto;
    width: var(--e-3);
    height: 1px;
    background: var(--realce);
  }

  .rotulo + h1,
  .rotulo + h2 {
    margin-top: 0;
  }

  h2 {
    margin-bottom: var(--e-2);
  }

  /* La entradilla es grande pero NO es un título: va en la de cuerpo, para que el <h2>
