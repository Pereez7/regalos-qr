---
import VentaLayout from "../layouts/VentaLayout.astro";
import {
  COOKIE_OPS,
  DURACION_COOKIE_OPS,
  claveOpsValida,
  cookieOpsValida,
  secretoOps,
  tokenOps,
} from "../lib/ops.ts";
import {
  avisosPendientesOFallidos,
  discrepanciasDeMonto,
  eventosSinPedido,
  pagosPorConfirmar,
  pedidosIniciadosNuncaPagados,
  pedidosPagadosSinRegalo,
} from "../lib/pedidos.ts";
import { formatearPrecio } from "../lib/config.ts";

export const prerender = false;

// FR-008 y research.md #14: la cola operativa. Visibilidad, no administración — el panel
// completo está fuera de alcance.
//
// Compuerta PROPIA, derivada de OPS_SECRET e independiente de MODO_INTERNO: ese flag se
// apaga el día que la landing se abre al público, y esta página muestra correos de
// compradores (CONTRADICCIONES H9). Sin credencial responde 404 y no 401, igual que
// /acceso: un 401 delataría que acá hay algo.

const clave = Astro.url.searchParams.get("clave");
const cookie = Astro.cookies.get(COOKIE_OPS)?.value;
const autorizado = claveOpsValida(clave) || cookieOpsValida(cookie);

if (!autorizado) {
  return new Response(null, { status: 404 });
}

// La clave correcta deja la cookie, para no tener que llevar el secreto en la barra de
// direcciones en cada recarga. Lo que se guarda es el token DERIVADO, no OPS_SECRET: una
// cookie filtrada no puede borrar pedidos por API.
if (claveOpsValida(clave) && secretoOps()) {
  Astro.cookies.set(COOKIE_OPS, tokenOps()!, {
    httpOnly: true,
    secure: Astro.url.protocol === "https:",
    sameSite: "lax",
    path: "/",
    maxAge: DURACION_COOKIE_OPS,
  });
}

const [porConfirmar, pagadosSinRegalo, abandonados, avisos, huerfanos, discrepancias] =
  await Promise.all([
    pagosPorConfirmar(),
    pedidosPagadosSinRegalo(),
    pedidosIniciadosNuncaPagados(),
    avisosPendientesOFallidos(),
    eventosSinPedido(),
    discrepanciasDeMonto(),
  ]);

function fecha(valor: string): string {
  return new Date(valor).toLocaleString("es-BO");
}
---

<VentaLayout titulo="Cola operativa" ancho="amplio">
  <h1>Cola operativa</h1>
  <p>
    Lo que quedó a medio camino. Ningún pedido se pierde: si algo salió torcido, está en una
    de estas listas.
  </p>

  <p class="pista">En el celular, las listas de abajo se desplazan de lado para leerse enteras.</p>

  <form method="POST" action="/salir-cola" class="salir">
    <button type="submit" class="boton boton-secundario" data-salir>Salir</button>
  </form>

  <h2>Pagos por QR esperando confirmación ({porConfirmar.length})</h2>
  <p>
    Compradores que dicen haber pagado. Buscá el comprobante en la app del banco y confirmá.
    Confirmar dos veces no cobra dos veces: podés apretar sin miedo.
  </p>
  {
    porConfirmar.length === 0 ? (
      <p>Nada esperando.</p>
    ) : (
      <div class="tabla-scroll">
        <table class="confirmar">
          <thead>
            <tr>
              <th>Pedido</th>
              <th>Correo</th>
              <th>Importe</th>
              <th>Comprobante</th>
              <th>Declarado</th>
              <th>Confirmar</th>
            </tr>
          </thead>
          <tbody>
            {porConfirmar.map((pago) => (
              <tr data-por-confirmar={pago.pedidoId}>
                <td data-etiqueta="Pedido">
                  <a href={`/gracias/${pago.pedidoId}`}>{pago.pedidoId.slice(0, 8)}</a>
                </td>
                <td class="correo" data-etiqueta="Correo">{pago.email}</td>
                <td data-etiqueta="Importe">
                  {formatearPrecio({ centavos: pago.montoCentavos, moneda: pago.moneda })}
                </td>
                <td data-etiqueta="Comprobante">{pago.referenciaComprador}</td>
                <td class="fecha" data-etiqueta="Declarado">{fecha(pago.creadoEn)}</td>
                <td class="accion">
                  <form method="POST" action={`/api/pagos/confirmar/${pago.pedidoId}`}>
                    <input type="hidden" name="decision" value="aprobado" />
                    <button type="submit" class="boton" data-confirmar>
                      Recibí este pago
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Pagados sin regalo entregado ({pagadosSinRegalo.length})</h2>
  {
    pagadosSinRegalo.length === 0 ? (
      <p>Nada pendiente.</p>
    ) : (
      <div class="tabla-scroll">
        <table>
          <thead>
            <tr>
              <th>Pedido</th>
              <th>Correo</th>
              <th>Pagado</th>
              <th>Regalo</th>
            </tr>
          </thead>
          <tbody>
            {pagadosSinRegalo.map((pedido) => (
              <tr data-pedido={pedido.id} data-estado={pedido.estado}>
                <td><a href={`/gracias/${pedido.id}`}>{pedido.id.slice(0, 8)}</a></td>
                <td class="correo">{pedido.email}</td>
                <td class="fecha">{pedido.pagadoEn ? fecha(pedido.pagadoEn) : "—"}</td>
                <td>
                  {pedido.regaloId == null
                    ? "sin enviar"
                    : pedido.estadoRegalo === "en_revision"
                      ? "en revisión"
                      : (pedido.estadoRegalo ?? "—")}
                  {pedido.slugRegalo && <> · <a href={`/r/${pedido.slugRegalo}`}>{pedido.slugRegalo}</a></>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Intentos abandonados ({abandonados.length})</h2>
  <p>Pedidos iniciados que nunca se pagaron. Basura inofensiva: nunca una venta.</p>
  {
    abandonados.length > 0 && (
      <div class="tabla-scroll">
        <table>
          <thead>
            <tr>
              <th>Pedido</th>
              <th>Correo</th>
              <th>Iniciado</th>
            </tr>
          </thead>
          <tbody>
            {abandonados.map((pedido) => (
              <tr data-pedido={pedido.id} data-estado={pedido.estado}>
                <td>{pedido.id.slice(0, 8)}</td>
                <td class="correo">{pedido.email}</td>
                <td class="fecha">{fecha(pedido.creadoEn)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Avisos sin enviar o fallidos ({avisos.length})</h2>
  <p>
    Nada se reintenta solo: el aviso que falló se queda acá hasta que vos lo reencoles.
    Reintentar no crea un aviso nuevo, usa el mismo y suma un intento.
  </p>
  {
    avisos.length > 0 && (
      <div class="tabla-scroll">
        <table>
          <thead>
            <tr>
              <th>Pedido</th>
              <th>Tipo</th>
              <th>Destinatario</th>
              <th>Estado</th>
              <th>Intentos</th>
              <th>Error</th>
              <th>Reintentar</th>
            </tr>
          </thead>
          <tbody>
            {avisos.map((aviso) => (
              <tr data-aviso={aviso.id} data-estado={aviso.estado}>
                <td>{aviso.pedidoId.slice(0, 8)}</td>
                <td>{aviso.tipo}</td>
                <td class="correo">{aviso.destinatario}</td>
                <td>{aviso.estado}</td>
                <td>{aviso.intentos}</td>
                <td>{aviso.error ?? "—"}</td>
                <td>
                  <form method="POST" action={`/api/avisos/${aviso.id}/reintentar`}>
                    <button type="submit" class="boton" data-reintentar>
                      Reintentar
                    </button>
                  </form>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Avisos de pago sin pedido ({huerfanos.length})</h2>
  <p>
    No debería haber ninguno: el pedido nace antes de ir a pagar. Cada fila es un error real
    —otro entorno, un pedido borrado, o un aviso apócrifo con firma válida—.
  </p>
  {
    huerfanos.length > 0 && (
      <div class="tabla-scroll">
        <table>
          <thead>
            <tr>
              <th>Proveedor</th>
              <th>Evento</th>
              <th>Informó</th>
              <th>Recibido</th>
            </tr>
          </thead>
          <tbody>
            {huerfanos.map((evento) => (
              <tr data-evento={evento.id}>
                <td>{evento.proveedor}</td>
                <td>{evento.eventoId}</td>
                <td>{evento.estadoInformado}</td>
                <td class="fecha">{fecha(evento.recibidoEn)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Discrepancias de monto ({discrepancias.length})</h2>
  <p>
    El comprador recibió lo que pagó y el pago no se bloqueó. Qué hacer con la diferencia
    —reintegrar, cobrar el resto o dejarla pasar— se decide caso por caso.
  </p>
  {
    discrepancias.length > 0 && (
      <div class="tabla-scroll">
        <table>
          <thead>
            <tr>
              <th>Pedido</th>
              <th>Cotizado</th>
              <th>Informado</th>
              <th>Moneda</th>
              <th>Actualizado</th>
            </tr>
          </thead>
          <tbody>
            {discrepancias.map((d) => (
              <tr data-discrepancia={d.pagoId}>
                <td>{d.pedidoId.slice(0, 8)}</td>
                <td>{d.montoCotizadoCentavos}</td>
                <td>{d.montoInformadoCentavos}</td>
                <td>{d.moneda}</td>
                <td class="fecha">{fecha(d.actualizadoEn)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</VentaLayout>

<style>
  .salir {
    margin: 0 0 var(--e-3);
  }

  .pista {
    font-size: var(--t-pequeno);
    color: var(--texto-suave);
  }

  /* FR-032: en vez de aplastarse hasta lo ilegible, la tabla hace scroll dentro de
     .tabla-scroll. El body nunca se desplaza de lado. */
  table {
    min-width: 48rem;
  }

  .tabla-scroll {
    margin: 0 0 var(--e-3);
  }

  td .boton {
    white-space: nowrap;
  }

  td.fecha {
    white-space: nowrap;
  }

  td.correo {
    overflow-wrap: anywhere;
  }

  /* En el celular, la tabla de confirmación deja de ser tabla y pasa a ser una ficha por
     pago. Es la acción que el negocio hace todos los días y desde el teléfono: tener que
     desplazar la tabla de lado para alcanzar el botón la vuelve incómoda justo donde más se
     usa. Las otras cuatro tablas se consultan, no se operan, y se quedan como están. */
  @media (max-width: 40rem) {
    .confirmar,
    .confirmar tbody,
    .confirmar tr,
    .confirmar td {
      display: block;
      width: auto;
      min-width: 0;
    }

    .confirmar thead {
      display: none;
    }

    .confirmar tr {
      padding: var(--e-2) 0;
      border-bottom: 1px solid var(--borde);
    }

    .confirmar td {
      padding: 0 0 var(--e-1);
      border: 0;
    }

    .confirmar td::before {
      content: attr(data-etiqueta) ": ";
      color: var(--texto-suave);
    }

    .confirmar td.accion::before {
      content: none;
    }

    .confirmar td.accion .boton {
      display: block;
      width: 100%;
      text-align: center;
    }
  }
</style>
