---
export const prerender = false;

// La puerta vieja. Antes el formulario vivía acá y pedía un único secreto pegado; ahora pide
// usuario y contraseña en `/admin`.
//
// Esto sigue existiendo porque la dirección quedó en marcadores, en el historial de teléfonos
// y en la nota de operación de alguien. Una redirección cuesta nada y evita que el día que
// haga falta entrar rápido la única dirección recordada conteste 404.
return Astro.redirect("/admin", 307);
---
