---
import { COOKIE_OPS } from "../lib/ops.ts";

export const prerender = false;

// Cierra la sesión de la cola en este navegador. Con una sesión que se renueva sola mientras
// se la usa, poder salir deja de ser un adorno: es lo que hace segura una entrada desde un
// teléfono prestado.
//
// Es POST y no GET a propósito: un GET lo dispara cualquier precargador de enlaces, y nadie
// quiere que el navegador lo saque de la cola por adelantar una página.

if (Astro.request.method !== "POST") {
  return Astro.redirect("/pedidos", 303);
}

Astro.cookies.delete(COOKIE_OPS, { path: "/" });

return Astro.redirect("/admin", 303);
---

<!-- Esta página nunca se renderiza: los dos caminos redirigen. -->
