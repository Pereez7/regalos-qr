# Supabase (ver research.md #9). En desarrollo local, estos valores los imprime
# `supabase start`. En producción, son los del proyecto Supabase real.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto de servidor para proteger DELETE /api/regalos/[id]/eliminar (research.md #9,
# contracts/api-eliminar.md). No es el UUID del regalo.
OPS_SECRET=

# URL base pública del sitio (sin barra final). Es la que se arma dentro del QR.
# Hoy es el dominio de Vercel; más adelante, el dominio propio.
# ATENCIÓN (Principio VI — lo entregado es inmutable): mientras esto apunte a
# vercel.app, NINGÚN QR destinado a una venta real puede generarse. Un QR impreso no
# se actualiza nunca; si apunta a vercel.app, el regalo muere el día que cambie el
# dominio. Primero el dominio propio, después el primer QR entregado.
SITIO_URL=

# Compuerta de acceso del deploy interno (src/middleware.ts). `1` la enciende: todo lo
# que no sea /acceso, /robots.txt o /fuentes/* exige la cookie `acceso_interno` y, si
# falta, contesta 404. Vacío o `0` la deja apagada y el middleware es transparente.
# Se usa porque los deploys de Vercel son públicos por defecto y el sitio todavía está
# en simulación de ventas, sin clientes reales.
MODO_INTERNO=

# Secreto que habilita el acceso interno vía /acceso?clave=... (setea la cookie por
# 30 días). Solo tiene efecto con MODO_INTERNO=1; si falta mientras el modo interno
# está encendido, el sitio contesta 404 a todo (fail-closed: un error de configuración
# nunca abre el sitio).
ACCESO_INTERNO_SECRETO=

# --- Feature 002: de la compra al QR ---

# Proveedor de cobro activo (src/lib/pagos/registro.ts). `simulado` es el único que existe
# al cierre de la feature 002: permite recorrer la venta completa sin cuenta en ningún
# proveedor, sin túnel y sin tarjeta de prueba (FR-007, research.md #3). Conectar un
# proveedor real es escribir un archivo nuevo en src/lib/pagos/ y cambiar este valor.
PAGO_PROVEEDOR=simulado

# Secreto con el que el proveedor simulado firma sus avisos (HMAC-SHA256 sobre el cuerpo
# crudo, cabecera `X-Firma`). Existe para que el camino de verificación de firma se
# ejercite de verdad en simulación y no quede como código sin probar hasta el día que se
# conecte el proveedor real (research.md #3). La protección del webhook es la firma, nunca
# el origen de la petición (FR-005, Principio VII).
PAGO_SIMULADO_SECRETO=

# Proveedor de correo activo (src/lib/correo/registro.ts). `consola` en desarrollo y
# simulación —escribe el aviso por salida estándar y permite recorrer la feature sin cuenta
# de correo (FR-028)—, `resend` en producción. El registro en la tabla `avisos` es el mismo
# con cualquiera de los dos: el requisito es del negocio, no del proveedor (research.md #12).
CORREO_PROVEEDOR=consola

# Clave de Resend. Solo hace falta con CORREO_PROVEEDOR=resend.
RESEND_API_KEY=

# Precio de venta en unidades mínimas de la moneda (centavos), entero. Un monto en coma
# flotante es un error de dinero esperando su redondeo.
# Se lee en RUNTIME con el patrón `import.meta.env.X ?? process.env.X` (research.md #18):
# escrito solo como `import.meta.env.X`, Vite hornearía el valor al compilar y cambiar el
# precio exigiría reconstruir y redesplegar. Cada pago guarda el monto con el que se cobró,
# así que un cambio de precio no reescribe la historia de lo ya vendido.
PRECIO=

# Código ISO de la moneda, 3 letras mayúsculas (la base lo exige con un check).
MONEDA=
