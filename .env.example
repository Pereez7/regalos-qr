# Supabase (ver research.md #9). En desarrollo local, estos valores los imprime
# `supabase start`. En producción, son los del proyecto Supabase real.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto de servidor para proteger DELETE /api/regalos/[id]/eliminar (research.md #9,
# contracts/api-eliminar.md). No es el UUID del regalo.
OPS_SECRET=

# URL base pública del sitio (sin barra final). Es la que se arma dentro del QR.
# Hoy es el dominio de Vercel; más adelante, el dominio propio.
# ATENCIÓN (Principio VI — lo entregado es inmutable): mientras esto apunte a
# vercel.app, NINGÚN QR destinado a una venta real puede generarse. Un QR impreso no
# se actualiza nunca; si apunta a vercel.app, el regalo muere el día que cambie el
# dominio. Primero el dominio propio, después el primer QR entregado.
SITIO_URL=

# Compuerta de acceso del deploy interno (src/middleware.ts). `1` la enciende: todo lo
# que no sea /acceso, /robots.txt o /fuentes/* exige la cookie `acceso_interno` y, si
# falta, contesta 404. Vacío o `0` la deja apagada y el middleware es transparente.
# Se usa porque los deploys de Vercel son públicos por defecto y el sitio todavía está
# en simulación de ventas, sin clientes reales.
MODO_INTERNO=

# Secreto que habilita el acceso interno vía /acceso?clave=... (setea la cookie por
# 30 días). Solo tiene efecto con MODO_INTERNO=1; si falta mientras el modo interno
# está encendido, el sitio contesta 404 a todo (fail-closed: un error de configuración
# nunca abre el sitio).
ACCESO_INTERNO_SECRETO=
